#!/bin/bash
set -e

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
LOG_DIR="$HOME/Library/Logs/Shelf"
mkdir -p "$LOG_DIR"
cd "$ROOT"

if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
  . "$HOME/.nvm/nvm.sh"
fi

if ! command -v node >/dev/null 2>&1; then
  osascript -e 'display dialog "Shelf needs Node.js. Install it from nodejs.org, then try again." with title "Shelf" buttons {"OK"} default button "OK"'
  exit 1
fi

PORT="${PORT:-3000}"
URL="http://localhost:${PORT}"
LAN_IP="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)"

if ! curl -fsS "$URL" >/dev/null 2>&1; then
  nohup npm run dev -- --hostname 0.0.0.0 --port "$PORT" >> "$LOG_DIR/server.log" 2>&1 &
  echo $! > "$LOG_DIR/server.pid"
  for _ in {1..30}; do
    if curl -fsS "$URL" >/dev/null 2>&1; then break; fi
    sleep 1
  done
fi

open "$URL"
if [[ -n "$LAN_IP" ]]; then
  printf 'Phone/Kobo URL: http://%s:%s\n' "$LAN_IP" "$PORT" >> "$LOG_DIR/server.log"
fi
