generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  description String?
  coverUrl    String?
  narrator    String?
  series      String?
  finished    Boolean  @default(false)
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lastPartId String?

  parts      Part[]
  ebooks     Ebook[]
  bookmarks  Bookmark[]
  aiMessages AiMessage[]
  queued     QueueItem?
  shelves    ShelfBook[]
}

model Part {
  id        String  @id @default(cuid())
  bookId    String
  videoId   String
  title     String
  order     Int
  duration  Int     @default(0)
  thumbUrl  String?
  channel   String?

  positionSec Float    @default(0)
  completed   Boolean  @default(false)
  addedAt     DateTime @default(now())

  transcriptJson String?
  transcriptState String @default("unknown")

  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  bookmarks Bookmark[]

  @@unique([bookId, videoId])
  @@index([bookId, order])
}

model Chapter {
  id      String @id @default(cuid())
  partId  String
  title   String
  startSec Float
  endSec   Float?
  order   Int

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId, order])
}

model Ebook {
  id        String   @id @default(cuid())
  bookId    String
  fileName  String
  filePath  String
  format    String   @default("epub")
  cfi       String?
  progress  Float    @default(0)
  addedAt   DateTime @default(now())

  /** Cached parse of the EPUB into ordered text blocks. */
  blocksJson String?
  /** Reading position as a block index — replaces the CFI. */
  blockIndex Int?

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  syncMarks SyncMark[]
}

model SyncMark {
  id       String @id @default(cuid())
  ebookId  String
  partId   String
  timeSec  Float
  cfi      String
  /** Block index the native reader syncs against; cfi is kept for older marks. */
  blockIndex Int?
  label    String?

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@index([ebookId, timeSec])
}

model Bookmark {
  id        String   @id @default(cuid())
  bookId    String
  partId    String
  timeSec   Float
  note      String?
  label     String?
  /// What the narrator was saying at this moment, lifted from the transcript.
  quote     String?
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  bookId    String
  partId    String
  timeSec   Float
  kind      String   @default("ask")
  question  String
  answer    String
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
}

model Setting {
  key   String @id
  value String
}

/// One row per day of listening. The app only ever stored a current position, so there was
/// no way to say what you listened to last week; this accrues that from now on.
model ListeningDay {
  /// Local calendar date, YYYY-MM-DD.
  date    String @id
  /// Float, not Int: rounding each credited delta to a whole second discarded all of
  /// them back when saves fired several times a second.
  seconds Float  @default(0)
}

/// Books parked to listen to next. Stumbling on something while listening to something
/// else is the common case, and without somewhere to put it you forget it.
model QueueItem {
  id      String   @id @default(cuid())
  bookId  String   @unique
  order   Int
  addedAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([order])
}

/// A named shelf. Yours to name — "Classics", "Long haul" — rather than a fixed taxonomy.
model Shelf {
  id        String      @id @default(cuid())
  name      String      @unique
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  books     ShelfBook[]
}

model ShelfBook {
  shelfId String
  bookId  String
  addedAt DateTime @default(now())

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([shelfId, bookId])
}

/// A continuous run of listening. The player saves its position every few seconds, so a
/// session is a chain of those saves with no long gap between them. Recording this is what
/// makes session length, time of day and average speed answerable — none of which the
/// per-day tally could ever support.
model ListeningSession {
  id        String   @id @default(cuid())
  bookId    String?
  partId    String?
  startedAt DateTime @default(now())
  /// Bumped on every credited save, so an abandoned session still has a sane end.
  endedAt   DateTime @default(now())
  /// Audio actually heard. At 2x that is twice the wall-clock time, which is the point —
  /// the figure describes the book, not the clock.
  seconds   Float    @default(0)
  /// Rate weighted by the seconds it applied to, so the average reflects real listening.
  rateSum   Float    @default(0)

  @@index([startedAt])
}
